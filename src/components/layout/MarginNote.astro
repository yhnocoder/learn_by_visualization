---
// 边注：宽屏时放在正文右侧的边注栏里，和它前面的段落顶端对齐；边注栏放不下时回到正文里，显示成浅色的注释块。
// 写在被注释的段落之前：
//   <MarginNote>这里的 $d_{ff}$ 指中间层宽度。</MarginNote>
//   正文段落……
interface Props { label?: string }
const { label } = Astro.props;
---
<aside class="margin-note">
  {label && <span class="k">{label}</span>}
  <slot />
</aside>

<style>
  .margin-note{font-size:13.5px; line-height:1.7; color:var(--ink-2)}
  .margin-note :global(p:last-child){margin-bottom:0}
  .k{display:block; font-family:var(--font-mono); font-size:11.5px; letter-spacing:.08em; color:var(--ink-3); margin-bottom:4px}
  @media (min-width:1400px){
    .margin-note{float:right; clear:right; width:var(--margin-col); margin-right:calc(-1 * var(--wide-extend, 0px)); padding-top:4px; border-top:1px solid var(--rule)}
  }
  @media (max-width:1399px){
    .margin-note{background:var(--surface-2); padding:12px 16px; margin:14px 0 20px; border-radius:8px}
  }
</style>
