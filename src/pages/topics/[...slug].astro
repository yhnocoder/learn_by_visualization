---
// 每个 src/topics/**/*.mdx 生成一个页面，按 frontmatter 的 format 选择版式。
import { getCollection, render } from 'astro:content';
import Essay from '../../layouts/Essay.astro';
import Paper from '../../layouts/Paper.astro';
import BentoPage from '../../layouts/BentoPage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('topics');
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const data = entry.data;
---
{data.format === 'paper' ? (
  <Paper {...data}><Content /></Paper>
) : data.format === 'bento' ? (
  <BentoPage {...data}><Content /></BentoPage>
) : (
  <Essay {...data} tocItems={remarkPluginFrontmatter.toc ?? []}><Content /></Essay>
)}
