---
// 卡片网格版式的整页外壳：顶部标题区，下面的内容通常是一个或多个 <Bento> 网格。
// 卡片之间没有先后顺序，适合速查、概览类的页面。
import Base from './Base.astro';

interface Props {
  title: string;
  pageTitle?: string;
  description?: string;
  eyebrow?: string;
  lede?: string;
  theme?: string;
  runtimeMath?: boolean;
}
const { title, pageTitle, description, eyebrow, lede, theme, runtimeMath } = Astro.props;
---
<Base title={pageTitle ?? title} description={description} theme={theme} runtimeMath={runtimeMath} bodyClass="bento-body">
  <slot name="head" slot="head" />
  <div class="bento-page">
    <header>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede" set:html={lede} />}
    </header>
    <main>
      <slot />
    </main>
  </div>
</Base>

<style is:global>
  body.bento-body{padding:0 var(--gutter) 80px}
  .bento-page{max-width:1240px; margin:0 auto; --wide-extend:0px}
  .bento-page > header{padding:48px 0 12px}
  .bento-page .eyebrow{font-family:var(--font-mono); font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-3); margin:0 0 12px}
  .bento-page h1{font-size:clamp(30px,4vw,44px); line-height:1.2; margin:0 0 12px}
  .bento-page .lede{font-size:17px; color:var(--ink-2); max-width:52em; margin:0}
  .bento-page main > section > h2{font-size:22px; margin:36px 0 4px}
</style>
