---
// 第 2 节的滑动窗口图：控件、SVG 和样本列表。脚本在 ../lib/window.js。
import Tex from '../../../components/layout/Tex.astro';
---
<div class="win-demo">
  <div class="controls">
    <label>中心词位置 <Tex t={String.raw`t`} /> <input type="range" id="win-t" min="1" max="8" value="4" step="1"><span class="v" id="win-t-v">4</span></label>
    <label>窗口大小 <Tex t={String.raw`m`} /> <input type="range" id="win-m" min="1" max="3" value="2" step="1"><span class="v" id="win-m-v">2</span></label>
  </div>
  <div class="plotwrap"><svg class="win" id="win-svg" viewBox="0 0 720 250" role="img" aria-label="滑动窗口示意图"></svg></div>
  <div class="pairs" id="win-pairs" aria-live="polite"></div>
  <div class="chart-status" id="win-status"></div>
</div>
<script>
  import { initWindowDemo } from '../lib/window.js';
  document.querySelectorAll('.win-demo').forEach(initWindowDemo);
</script>
<style is:global>
  .win .tok rect{fill:var(--surface-2); stroke:var(--rule-2); stroke-width:1}
  .win .tok text{fill:var(--ink); font-family:var(--font-mono); font-size:14px}
  .win .tok.ctx rect{fill:var(--ctx-soft); stroke:var(--ctx)}
  .win .tok.center rect{fill:var(--center-soft); stroke:var(--center); stroke-width:1.5}
  .win .tok.center text{font-weight:500}
  .win .tok{cursor:pointer}
  .win .tok:hover rect{stroke:var(--ink-2)}
  .win .idx{fill:var(--ink-3); font-family:var(--font-mono); font-size:11px}
  .win .arc{fill:none; stroke:var(--ctx); stroke-width:1.4}
  .win .lbl{fill:var(--ink-2); font-family:var(--font-mono); font-size:11.5px}
  .win .brace{fill:none; stroke:var(--ink-3); stroke-width:1}
  .win .cap{fill:var(--ink-2); font-size:12px}
  .win .cap.c{fill:var(--center)}
  .pairs{display:flex; flex-wrap:wrap; gap:8px; margin:6px 0 4px; font-family:var(--font-mono); font-size:13px}
  .pairs span{padding:2px 10px; border:1px solid var(--rule-2); border-radius:99px; background:var(--surface-2); font-variant-numeric:tabular-nums}
  .pairs span b{font-weight:400; color:var(--center)}
  .pairs span i{font-style:normal; color:var(--ctx)}
</style>
