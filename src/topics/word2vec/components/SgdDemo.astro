---
// 第 5 节的“一步更新”图：控件、步骤切换按钮、V 和 U 两个矩阵、结果列和详情区。脚本在 ../lib/sgd.js。
import Tex from '../../../components/layout/Tex.astro';
---
<div class="sgd-demo">
  <div class="controls">
    <label>中心词 <Tex t={String.raw`c`} /> <select id="sg-c"></select></label>
    <label>上下文词 <Tex t={String.raw`o`} /> <select id="sg-o"></select></label>
    <label>学习率 <Tex t={String.raw`\eta`} /> <input type="range" id="sg-lr" min="0.05" max="1" step="0.05" value="0.5"><span class="v" id="sg-lr-v">0.50</span></label>
    <button class="btn primary" type="button" id="sg-step">执行一步更新</button>
    <button class="btn" type="button" id="sg-reset">重置参数</button>
  </div>
  <div class="sg-modes" aria-label="计算步骤">
    <button type="button" data-sg-mode="forward" aria-pressed="true">1 · 分数与概率</button>
    <button type="button" data-sg-mode="gradient" aria-pressed="false">2 · 梯度</button>
    <button type="button" data-sg-mode="update" aria-pressed="false">3 · 更新预览</button>
  </div>
  <div class="sg-flow">
    <section><h4><Tex t={String.raw`\mathbf{V}`} /> <small><Tex t={String.raw`8\times 2`} /> · 输入向量</small></h4><div id="sg-v-matrix"></div><p class="sg-note">标记 c 的行参与本次计算</p></section>
    <section><h4><Tex t={String.raw`\mathbf{U}`} /> <small><Tex t={String.raw`8\times 2`} /> · 输出向量</small></h4><div id="sg-u-matrix"></div><p class="sg-note">全部行参与计算；点击一行查看</p></section>
    <section><h4 id="sg-result-title"><span data-sg-title="forward"><Tex t={String.raw`\mathbf{U}v_c \xrightarrow{\operatorname{softmax}} p`} /></span><span data-sg-title="gradient" hidden><Tex t={String.raw`\nabla_{\mathbf{U}}\ell`} /> <small>· 完整梯度</small></span><span data-sg-title="update" hidden><Tex t={String.raw`\mathbf{U}-\eta\nabla_{\mathbf{U}}\ell`} /> <small>· 更新后</small></span></h4><div id="sg-result"></div><p class="sg-note" id="sg-result-note"></p></section>
  </div>
  <div class="sg-detail" id="sg-detail" aria-live="polite"></div>
  <div class="chart-status" id="sg-status" aria-live="polite"></div>
</div>
<script>
  import { mathReady } from '../../../lib/math.js';
  import { initSgdDemo } from '../lib/sgd.js';
  await mathReady();
  document.querySelectorAll('.sgd-demo').forEach(initSgdDemo);
</script>
<style is:global>
  .sg-modes{display:flex; gap:8px; flex-wrap:wrap; margin:18px 0}
  .sg-modes button{font:inherit; font-size:13px; padding:7px 12px; background:transparent; border:1px solid var(--rule); border-radius:5px; cursor:pointer; color:var(--ink)}
  .sg-modes button[aria-pressed="true"]{background:var(--ink); color:var(--surface)}
  .sg-flow{display:grid; grid-template-columns:1fr 1fr 1.12fr; gap:22px}
  .sg-flow section{min-width:0; margin-bottom:0}
  .sg-flow h4{font-size:14px; font-weight:600; margin:0 0 12px}
  .sg-flow h4 small{font-size:11px; font-weight:400; color:var(--ink-2)}
  .sg-mrow,.sg-output{display:grid; width:100%; height:38px; align-items:center; gap:4px; border:0; border-bottom:1px solid var(--rule); background:transparent; color:var(--ink); font:12px var(--font-mono); text-align:left; padding:3px; cursor:pointer}
  .sg-mrow{grid-template-columns:minmax(78px,1fr) 49px 49px}
  .sg-output{grid-template-columns:minmax(78px,1fr) 1.4fr}
  .sg-mrow.selected,.sg-output.selected{background:color-mix(in srgb,var(--ctx) 5%,transparent); box-shadow:inset 2px 0 color-mix(in srgb,var(--ctx) 55%,transparent); border-radius:4px}
  .sg-mrow.selected > span:first-child,.sg-output.selected > span:first-child{padding-left:5px}
  .sg-mrow:focus-visible,.sg-output:focus-visible{outline:2px solid var(--ctx); outline-offset:2px}
  .sg-cell{text-align:center; padding:5px 0; background:color-mix(in srgb,var(--tone) calc(var(--strength)*100%),transparent); border-radius:3px; font-variant-numeric:tabular-nums}
  .sg-note{font-size:12px; color:var(--ink-2); line-height:1.6}
  .sg-pair{white-space:nowrap; font-size:11px; text-align:right}
  .sg-prob{position:relative; height:25px; background:color-mix(in srgb,var(--ctx) 7%,transparent)}
  .sg-prob i{position:absolute; inset:0 auto 0 0; background:color-mix(in srgb,var(--ctx) 40%,transparent); transition:width .25s}
  .sg-prob b{position:relative; display:block; padding:3px 5px; font-weight:400; text-align:right}
  .sg-detail{margin-top:16px; padding:14px 16px; background:color-mix(in srgb,var(--ctx) 5%,transparent); font-size:13px; line-height:1.9; overflow-wrap:anywhere}
  .sg-detail strong{font-weight:600}
  .sg-detail > div{overflow-x:auto; padding:4px 0}
  .sg-detail > div.cont{padding-left:2.4em; padding-top:0; margin-top:-4px}
  .sg-detail mjx-container{max-width:none}
  @media (max-width:1000px){
    .sg-flow{grid-template-columns:1fr 1fr; gap:16px}
    .sg-flow section:last-child{grid-column:1/-1}
    .sg-flow section:last-child #sg-result{display:grid; grid-template-columns:1fr 1fr; gap:0 20px}
  }
  @media (max-width:560px){
    .sg-flow{grid-template-columns:1fr}
    .sg-flow section:last-child #sg-result{grid-template-columns:1fr}
    .sg-flow h4{margin-bottom:6px}
  }
  @media (prefers-reduced-motion:reduce){ .sg-prob i{transition:none} }
</style>
