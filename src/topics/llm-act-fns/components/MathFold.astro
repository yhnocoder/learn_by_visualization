---
// 默认收起的补充内容，与 src/components/layout/Fold.astro 相同，区别是标题写在名为 summary 的 slot 里，
// 因此标题可以含构建时渲染的公式：
//   <MathFold>
//     <span slot="summary">展开了解：为什么期望恰好是 $x\Phi(x)$？</span>
//     正文……
//   </MathFold>
// 共用的 Fold 的 summary 是字符串属性，其中的 $...$ 不会被渲染。共用的 Fold 支持 summary slot 之后，这个组件可以删除。
interface Props { open?: boolean }
const { open = false } = Astro.props;
---
<details class="fold" open={open}>
  <summary><slot name="summary" /></summary>
  <div class="body"><slot /></div>
</details>

<script>
  import '../../../scripts/fold.js';
</script>

<style>
  .fold{margin:14px 0 20px; font-size:15.5px}
  summary{cursor:pointer; list-style:none; display:inline-flex; align-items:center; gap:8px; padding:4px 0; color:var(--ink-2); font-weight:500; transition:color .15s}
  summary:hover, .fold[open] summary{color:var(--ink)}
  summary::-webkit-details-marker{display:none}
  summary::after{content:''; flex:none; width:6px; height:6px; margin-left:2px; border-right:1.5px solid currentColor; border-bottom:1.5px solid currentColor; transform:rotate(-45deg); transition:transform .2s}
  .fold[open] summary::after{transform:rotate(45deg) translate(-2px,-2px)}
  .body{margin-top:10px; padding:2px 0 2px 20px; border-left:2px solid var(--rule-2)}
  .body > :global(:last-child){margin-bottom:0}
  summary:focus-visible{outline:2px solid var(--accent); outline-offset:3px; border-radius:4px}
</style>
