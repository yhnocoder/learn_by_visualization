---
// 偏导数与梯度：f(x, y) = 3x²y 的取值与等值线，两个偏导数、梯度，以及两条剖面曲线。脚本在 lib/gradient.js。
// 图题写在默认插槽里（<figcaption>）。
import { md, tex } from '../../../../lib/tex-build.js';
---
<figure class="fig grad" id="figGrad">
  <div class="controls">
    <label><Fragment set:html={tex('x_0')} /> <input type="range" id="gx" data-grad="x" min="-2" max="2" step="0.01" value="1.2" /> <span class="v" id="gxv" data-grad="xv">1.20</span></label>
    <label><Fragment set:html={tex('y_0')} /> <input type="range" id="gy" data-grad="y" min="-2" max="2" step="0.01" value="0.8" /> <span class="v" id="gyv" data-grad="yv">0.80</span></label>
  </div>
  <div class="stage">
    <div class="plot field"><svg id="gField" data-grad="field" viewBox="0 0 348 300" role="img" aria-label="f(x,y) 的取值和等值线、当前位置、两个偏导数和梯度"></svg></div>
    <div>
      <div class="plot"><svg id="gSx" data-grad="sx" viewBox="0 0 460 140" role="img" aria-label="固定 y，只动 x 的剖面曲线和切线"></svg></div>
      <div class="plot"><svg id="gSy" data-grad="sy" viewBox="0 0 460 140" role="img" aria-label="固定 x，只动 y 的剖面曲线和切线"></svg></div>
    </div>
  </div>
  <div class="readout">
    <div class="x"><Fragment set:html={tex('\\dfrac{\\partial f}{\\partial x} = 6x_0y_0')} /> = <b id="gpx" data-grad="px">5.760</b></div>
    <div class="y"><Fragment set:html={tex('\\dfrac{\\partial f}{\\partial y} = 3x_0^2')} /> = <b id="gpy" data-grad="py">4.320</b></div>
    <div class="g"><Fragment set:html={md('$\\nabla f$ = [')} /><b id="gg1" data-grad="g1">5.760</b>&nbsp; <b id="gg2" data-grad="g2">4.320</b>]</div>
  </div>
  <slot />
</figure>

<script>
  import { mathReady } from '../../../../lib/math.js';
  import { initGradient } from '../../lib/gradient.js';
  await mathReady();
  document.querySelectorAll<HTMLElement>('figure.grad').forEach(initGradient);
</script>

<style is:global>
  .grad .stage{display:grid; grid-template-columns:348px 1fr; gap:10px 18px; align-items:start}
  .grad .plot svg{cursor:default}
  .grad .plot.field svg{cursor:move}
  .grad .plot line.axis{stroke:var(--axis); stroke-width:1}
  .grad .plot line.grid{stroke:var(--grid); stroke-width:1}
  .grad .plot path.curve{fill:none; stroke:var(--ink); stroke-width:2}
  .grad .plot line.tx{stroke:var(--s3); stroke-width:2}
  .grad .plot line.ty{stroke:var(--s5); stroke-width:2}
  .grad .plot line.guide{stroke:var(--ink-3); stroke-width:1; stroke-dasharray:2 3}
  .grad .plot line.slx{stroke:var(--s3); stroke-width:1.5; stroke-dasharray:5 4}
  .grad .plot line.sly{stroke:var(--s5); stroke-width:1.5; stroke-dasharray:5 4}
  .grad .plot circle.p0{fill:var(--ink); stroke:var(--surface); stroke-width:2}
  .grad .plot circle.px{fill:var(--s3); stroke:var(--surface); stroke-width:2}
  .grad .plot circle.py{fill:var(--s5); stroke:var(--surface); stroke-width:2}
  .grad .plot path.gradv{fill:none; stroke:var(--s7); stroke-width:2.5}
  .grad .plot path.cx{fill:none; stroke:var(--s3); stroke-width:2.2}
  .grad .plot path.cy{fill:none; stroke:var(--s5); stroke-width:2.2}
  .grad .plot path.box{fill:none; stroke:var(--ink-3); stroke-width:1; stroke-dasharray:3 3}
  .grad .plot path.contour{fill:none; stroke:var(--ink); stroke-width:1.4}
  .grad .plot svg.tex{overflow:visible; color:var(--ink-2)}
  .grad .plot text.t{font-size:12px; fill:var(--ink-2)}
  .grad .readout{display:grid; grid-template-columns:repeat(3,auto); gap:8px 24px; font-size:14px; margin:8px 0 4px; padding:10px 14px; background:var(--surface-2); border-radius:8px; align-items:center; justify-content:start}
  .grad .readout b{font-family:var(--font-mono); font-weight:500; font-variant-numeric:tabular-nums}
  .grad .readout .x b{color:var(--s3)}
  .grad .readout .y b{color:var(--s5)}
  .grad .readout .g b{color:var(--s7)}
  .grad .controls input[type=range]{accent-color:var(--accent); width:110px}
  @media (max-width:720px){
    .grad .stage{grid-template-columns:1fr}
    .grad .readout{grid-template-columns:1fr}
  }
</style>
