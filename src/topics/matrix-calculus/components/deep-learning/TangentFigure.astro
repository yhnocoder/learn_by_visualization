---
// 割线、切线与导数的图像：切换函数，拖动 x0 和 Δx，比较割线与切线的斜率。脚本在 lib/tangent.js。
import { md, tex } from '../../lib/tex-build.js';
const fns = [['cube', 'x^3'], ['sin', '\\sin x'], ['ln', '\\ln x'], ['swish', '\\mathrm{Swish}(x)']];
---
<figure class="fig tan" id="figTan">
  <div class="controls">
    <span class="fn" role="group" aria-label="选择函数">
      {fns.map(([fn, t], i) => <button type="button" data-fn={fn} aria-pressed={String(i === 0)} set:html={tex(t)} />)}
    </span>
    <label><Fragment set:html={tex('x_0')} /> <input type="range" id="tanX" data-tan="x" min="-1.9" max="1" step="0.01" value="1" /> <span class="v" id="tanXv" data-tan="xv">1.00</span></label>
    <label class="sec"><Fragment set:html={tex('\\Delta x')} /> <input type="range" id="tanDx" data-tan="dx" min="-3" max="0" step="0.01" value="-3" /> <span class="v" id="tanDxv" data-tan="dxv">0.001</span></label>
  </div>
  <div class="plot f"><svg id="tanSvg" data-tan="f" viewBox="0 0 760 300" role="img" aria-label="函数图像、过两点的割线和切线"></svg></div>
  <div class="readout">
    <div class="sec"><span class="k">过两点的直线，斜率</span> <Fragment set:html={tex('\\dfrac{f(x_0+\\Delta x)-f(x_0)}{\\Delta x}')} /> = <b id="secV" data-tan="sec">3.003</b></div>
    <div class="tg"><span class="k" set:html={md('切线的斜率，即 $x_0$ 处的')} /> <Fragment set:html={tex('\\dfrac{dy}{dx}')} /> = <b id="tanV" data-tan="tan">3.000</b></div>
  </div>
  <div class="plot d"><svg id="dSvg" data-tan="d" viewBox="0 0 760 170" role="img" aria-label="导数函数的图像"></svg></div>
</figure>

<script>
  import { mathReady } from '../../../../lib/math.js';
  import { initTangent } from '../../lib/tangent.js';
  await mathReady();
  document.querySelectorAll<HTMLElement>('figure.tan').forEach(initTangent);
</script>

<style is:global>
  .tan .plot svg{cursor:ew-resize}
  .tan .plot.d svg{cursor:default}
  .tan .plot path.curve{fill:none; stroke:var(--ink); stroke-width:2}
  .tan .plot path.dcurve{fill:none; stroke:var(--s1); stroke-width:2}
  .tan .plot line.axis{stroke:var(--axis); stroke-width:1}
  .tan .plot line.grid{stroke:var(--grid); stroke-width:1}
  .tan .plot line.tan{stroke:var(--s1); stroke-width:2}
  .tan .plot line.sec{stroke:var(--s2); stroke-width:2; stroke-dasharray:6 4}
  .tan .plot line.guide{stroke:var(--ink-3); stroke-width:1; stroke-dasharray:2 3}
  .tan .plot circle.p0{fill:var(--ink); stroke:var(--surface); stroke-width:2}
  .tan .plot circle.p1{fill:var(--s2); stroke:var(--surface); stroke-width:2}
  .tan .plot circle.pd{fill:var(--s1); stroke:var(--surface); stroke-width:2}
  .tan .plot .ov{transition:opacity .25s}
  .tan .plot .ov.off{opacity:0}
  .tan .plot svg.tex{overflow:visible; color:var(--ink-2)}
  .tan .readout{display:grid; grid-template-columns:1fr 1fr; gap:8px 20px; font-size:14px; margin:6px 0 4px; padding:10px 14px; background:var(--surface-2); border-radius:8px; align-items:center}
  .tan .readout .k{color:var(--ink-2)}
  .tan .readout b{font-family:var(--font-mono); font-weight:500; font-variant-numeric:tabular-nums; font-size:14px}
  .tan .readout .sec b{color:var(--s2)}
  .tan .readout .tg b{color:var(--s1)}
  .tan .controls label.sec{--accent:var(--s2)}
  .tan .controls input[type=range]{accent-color:var(--accent)}
  @media (max-width:600px){
    .tan .readout{grid-template-columns:1fr}
    .tan .plot text{font-size:19px}
    .tan .plot svg.tex{font-size:12px}
  }
</style>
