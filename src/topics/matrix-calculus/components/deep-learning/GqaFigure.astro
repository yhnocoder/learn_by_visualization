---
// MHA 与 GQA 的对比图，图由 lib/gqa.js 在浏览器端画出。
---
<figure class="fig gqa">
  <svg id="gqaSvg" class="dl-gqa" viewBox="0 0 700 180" role="img" aria-label="MHA 中每个 query head 有自己的 K 和 V；GQA 中每两个 query head 共用一组 K 和 V"></svg>
</figure>

<script>
  import { runtimeMathReady } from '../../lib/runtime-math.js';
  import { drawGqa } from '../../lib/gqa.js';
  await runtimeMathReady();
  document.querySelectorAll<SVGSVGElement>('svg.dl-gqa').forEach(drawGqa);
</script>

<style is:global>
  .gqa{overflow-x:auto}
  .gqa > svg{min-width:560px; width:100%; height:auto; display:block}
  .dl-gqa text{font:13px var(--font-sans); fill:var(--ink-2)}
  .dl-gqa rect{fill:var(--surface-2); stroke:var(--rule-2); rx:6}
  .dl-gqa path{fill:none; stroke:var(--ink-3); stroke-width:1.3}
  .dl-gqa rect.g1, .dl-gqa path.g1{stroke:var(--s1)}
  .dl-gqa rect.g2, .dl-gqa path.g2{stroke:var(--s2)}
  .dl-gqa svg.tex{overflow:visible; color:var(--ink)}
</style>
